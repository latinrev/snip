<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Snip</AssemblyName>
    <RootNamespace>Snip</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The interop structs are laid out for 64-bit Windows. -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Snip.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Version>1.0.0</Version>
    <Product>Snip</Product>
    <Title>Snip</Title>
    <Description>Screenshot, scrolling capture and screen recording tool for Windows</Description>
    <Authors>Joel Castillo</Authors>
    <Copyright>Copyright (c) 2026 Joel Castillo</Copyright>
    <RepositoryUrl>https://github.com/latinrev/snip</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <EmbeddedResource Include="Snip.ico" LogicalName="Snip.Snip.ico" />
    <InternalsVisibleTo Include="Snip.Tests" />
  </ItemGroup>
</Project>
